# Supabase (use the SAME project for local and production)
# Required for storefront: NEXT_PUBLIC_SUPABASE_URL + NEXT_PUBLIC_SUPABASE_ANON_KEY
# Required for admin (login, products CRUD): also set SUPABASE_SERVICE_ROLE_KEY in production
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (card payments via Stripe-hosted Checkout)
# Secret key (server-side only): https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
# Webhook signing secret: create an endpoint at
#   https://dashboard.stripe.com/webhooks  ->  https://yourdomain.com/api/checkout/webhook
# subscribe to: checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired, charge.refunded
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# Site URL (for checkout redirects and webhooks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
