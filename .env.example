# ⚠️  TEMPLATE ONLY — DO NOT PUT REAL SECRETS HERE.
# This file is committed to git. Put real values in .env.local (git-ignored)
# for local dev, and in the Netlify dashboard (Site settings → Environment
# variables) for production.

# Supabase (use the SAME project for local and production)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Stripe (card payments via Stripe-hosted Checkout)
# Secret key (server-side only): https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
# Webhook signing secret (https://dashboard.stripe.com/webhooks)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Site URL (for checkout redirects and webhooks), no trailing slash
NEXT_PUBLIC_SITE_URL=https://your-domain.com
